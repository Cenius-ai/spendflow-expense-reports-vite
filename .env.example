# Spendflow backend configuration. Every value has a working default in code,
# so the app boots with no .env file at all. Copy to backend/.env to override.

# SQLAlchemy database URL. Defaults to a SQLite file next to the backend code:
#   sqlite:///./spendflow.db
DATABASE_URL=sqlite:///./spendflow.db

# Secret used to sign HS256 session JWTs. install.sh generates a random value
# into backend/.env; the in-code development fallback is only for a bare boot.
JWT_SECRET=

# Session lifetime in hours.
TOKEN_TTL_HOURS=12

# Seed the demo workspace automatically when the database is empty.
SEED_ON_STARTUP=true

# Port the FastAPI service binds to (both services read it).
PORT=8000
